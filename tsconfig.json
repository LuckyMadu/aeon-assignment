{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "target": "ES2020",
    "types": ["jest"],
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "baseUrl": "./",
    "paths": {
      "@components": ["src/components"],
      "@components/*": ["src/components/*"],
      "@design-system": ["src/design-system"],
      "@design-system/*": ["src/design-system/*"],
      "@features/*": ["src/features/*"],
      "@navigation": ["src/navigation"],
      "@navigation/*": ["src/navigation/*"],
      "@services": ["src/services"],
      "@services/*": ["src/services/*"],
      "@store": ["src/store"],
      "@store/*": ["src/store/*"],
      "@app-types": ["src/types"],
      "@app-types/*": ["src/types/*"],
      "@utils": ["src/utils"],
      "@utils/*": ["src/utils/*"]
    }
  },
  "include": ["src", "App.tsx", "index.js", "**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods", "android", "ios"]
}
